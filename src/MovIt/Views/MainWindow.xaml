<Window x:Class="MovIt.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MovIt.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="MovIt"
        Icon="/Assets/MovIt.ico"
        Width="920" Height="660" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- header -->
            <RowDefinition Height="Auto" />  <!-- ffmpeg banner -->
            <RowDefinition Height="*" />     <!-- queue / drop zone -->
            <RowDefinition Height="Auto" />  <!-- options -->
            <RowDefinition Height="Auto" />  <!-- actions -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
            <Image DockPanel.Dock="Left" Source="/Assets/MovIt.png" Width="44" Height="44"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding AddFilesCommand}"
                    ToolTip="Add videos (or drag them onto the window)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Add videos" />
                </StackPanel>
            </Button>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="MovIt" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Convert any video to a QuickTime .mov file" Style="{StaticResource Caption}" FontSize="13" />
            </StackPanel>
        </DockPanel>

        <!-- ===== FFmpeg missing banner ===== -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="16,12" CornerRadius="8"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFFmpegAvailable}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" FontSize="18"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <Button DockPanel.Dock="Right" Content="Download FFmpeg" Style="{DynamicResource AccentButtonStyle}"
                        Command="{Binding InstallFFmpegCommand}" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontWeight="SemiBold" Text="FFmpeg is required" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="MovIt uses the free FFmpeg engine to convert video. It's about 100 MB and is installed just for MovIt." />
                    <ProgressBar Margin="0,8,0,0" Height="4" Maximum="1"
                                 Value="{Binding FFmpegInstallProgress, TargetNullValue=0}"
                                 Visibility="{Binding IsInstallingFFmpeg, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FFmpegInstallProgress}" Value="{x:Null}">
                                        <Setter Property="IsIndeterminate" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Queue / drop zone ===== -->
        <Grid Grid.Row="2">
            <!-- Empty state -->
            <Grid Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="2" StrokeDashArray="5 4"
                           Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                           Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource IconFont}" Text="&#xE8B2;"
                               FontSize="52" Foreground="{StaticResource BrandBrush}" />
                    <TextBlock HorizontalAlignment="Center" Margin="0,14,0,4" FontSize="18" FontWeight="SemiBold"
                               Text="Drop videos or folders here" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}"
                               Text="MP4, MKV, AVI, WMV, WebM, MPEG, MTS and more" />
                    <Button HorizontalAlignment="Center" Margin="0,18,0,0" Content="Browse…"
                            Style="{DynamicResource AccentButtonStyle}" Command="{Binding AddFilesCommand}" />
                </StackPanel>
            </Grid>

            <!-- Queue -->
            <Border Style="{StaticResource Card}" Padding="4"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                <ListBox ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConversionItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Glyph" Grid.Column="0" FontFamily="{StaticResource IconFont}"
                                           Text="{Binding StatusGlyph}" FontSize="18" Width="28"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Caption}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SourcePath}" />
                                    </DockPanel>
                                    <ProgressBar x:Name="Bar" Margin="0,6,0,4" Height="4" Maximum="1"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsIndeterminate}" Visibility="Collapsed" />
                                    <TextBlock x:Name="Msg" Text="{Binding Message}" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Play"
                                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Show in folder"
                                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button x:Name="RemoveButton" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove from list"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter TargetName="RemoveButton" Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Drag-over highlight -->
            <Border x:Name="DropOverlay" CornerRadius="12" BorderThickness="2" IsHitTestVisible="False" Visibility="Collapsed"
                    BorderBrush="{StaticResource BrandBrush}">
                <Border.Background>
                    <SolidColorBrush Color="#5C46FF" Opacity="0.10" />
                </Border.Background>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                           Text="Drop to add" />
            </Border>
        </Grid>

        <!-- ===== Options ===== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Quality" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                              DisplayMemberPath="Name" MinWidth="280" HorizontalAlignment="Left"
                              IsEnabled="{Binding IsIdle}" />
                    <TextBlock Text="{Binding SelectedPreset.Description}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>

                <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" IsChecked="{Binding Deinterlace}" IsEnabled="{Binding IsIdle}"
                          Content="Deinterlace (recommended for VHS and camcorder captures)"
                          ToolTip="Removes the comb-like lines on motion in interlaced video. Always re-encodes." />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Save to" VerticalAlignment="Center" Margin="0,12,16,0" />
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Content="Change…" Command="{Binding ChooseOutputFolderCommand}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetOutputFolderCommand}" Margin="8,0,0,0"
                            IsEnabled="{Binding IsIdle}"
                            Visibility="{Binding HasCustomOutputFolder, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding OutputFolderText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding OutputFolderText}" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- ===== Actions ===== -->
        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Clear list" Command="{Binding ClearCommand}" Margin="0,0,8,0"
                        Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Button Command="{Binding ConvertCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="20,8" MinWidth="150">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Convert to .mov" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
