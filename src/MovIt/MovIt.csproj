<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>MovIt</AssemblyName>
    <RootNamespace>MovIt</RootNamespace>
    <ApplicationIcon>Assets\MovIt.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>MovIt</Product>
    <Description>Convert any video to a QuickTime .mov file.</Description>
    <Version>1.0.0</Version>

    <!-- The Fluent theme (Application.ThemeMode) is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- Lets the project build from non-Windows machines / CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\MovIt.ico" />
    <Resource Include="Assets\MovIt.png" />
  </ItemGroup>

</Project>
