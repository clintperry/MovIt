<Application x:Class="MovIt.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MovIt.Converters"
             ThemeMode="System"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

            <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5C46FF" Offset="0" />
                <GradientStop Color="#FF547C" Offset="1" />
            </LinearGradientBrush>

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
